APP_NAME=ManhwaHQ API
APP_VERSION=0.6.0
ENVIRONMENT=development
API_PREFIX=/api/v1
SOURCE_BASE_URL=https://manhwahq.com
SOURCE_DATA_API_BASE_URL=https://b.toonking.xyz
SOURCE_SITE_KEY=manhwahq.com
SOURCE_TIMEOUT=25
SOURCE_MAX_RETRIES=2
SOURCE_MAX_CONCURRENT=3
SOURCE_CONNECTION_LIMIT=20
SOURCE_KEEPALIVE_LIMIT=10
CACHE_TTL_SECONDS=180
CACHE_MAX_ITEMS=512
CACHE_MAX_BYTES=67108864
ENABLE_BROWSER_FALLBACK=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://192.168.31.62:5173,https://manhwavoid.vercel.app

# User accounts (MongoDB is required for auth/profile endpoints)
# Set your MongoDB Atlas/self-hosted connection string to enable accounts.
MONGODB_URI=mongodb+srv://LordShadow:OtakuLordShadow@cluster0.hby3kq2.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=manhwahq
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=0
MONGODB_WAIT_QUEUE_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=15000
USER_ACTIVITY_TOUCH_INTERVAL_SECONDS=60
ACTIVITY_LOG_TTL_SECONDS=1800
JWT_SECRET=ZkZyn2de96F2vCnXvXyQTDXRpD7AA_bqMkUA-sxS0P-yb_XW4ru12qCFn9yuJRz4
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=30
AVATAR_UPLOAD_DIR=uploads/avatars


# Shared rate limiting (MongoDB)
# All deployments that should share counters MUST use the same MongoDB cluster
# and database via MONGODB_URI + MONGODB_DATABASE.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_COLLECTION=rate_limits
RATE_LIMIT_OPERATION_TIMEOUT=1.5
RATE_LIMIT_KEY_PREFIX=manhwahq:ratelimit
RATE_LIMIT_DEFAULT_PER_MINUTE=90
RATE_LIMIT_DISCOVERY_PER_MINUTE=60
RATE_LIMIT_READER_PER_MINUTE=30
RATE_LIMIT_USER_PER_MINUTE=90
RATE_LIMIT_LOGIN_PER_5_MINUTES=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_REFRESH_PER_MINUTE=30

# Vercel proxy secret. Set the SAME value as BACKEND_PROXY_SECRET in Vercel.
# When set, /api/ requests without the "x-proxy-secret" header get 403 (health check stays open).
# Leave empty to disable. Generate one with:  openssl rand -hex 32
PROXY_SECRET=
